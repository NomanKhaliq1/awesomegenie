# App
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Awesome Genie

# Supabase
# Create these from your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ADMIN_EMAIL=
SUPABASE_ADMIN_PASSWORD=

# AI Providers
# Fill only the providers you plan to use. Keep server-side keys out of client code.
GROQ_API_KEY=
GROQ_SLM_MODEL=llama-3.1-8b-instant
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_SLM_MODEL=gemini-1.5-flash
GEMINI_LLM_MODEL=gemini-1.5-pro
OPENROUTER_API_KEY=
OPENROUTER_SLM_MODEL=openai/gpt-4o-mini
# Keep OpenRouter LLM empty unless you intentionally want a larger paid model through OpenRouter.
OPENROUTER_LLM_MODEL=

# AI Routing
# Customer chat uses relevance checks, approved RAG, onboarding rules, and small-model answers.
# Large models are used only for complex relevant technical questions and admin/PM summary tasks.
# Set AI_ENABLE_PAID_CALLS=false to force rule-based replies only.
AI_ENABLE_PAID_CALLS=true

# Google Drive
# GOOGLE_PRIVATE_KEY usually contains escaped newlines: -----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# WordPress / Website Sync
WORDPRESS_BASE_URL=https://awesometechinc.com
WORDPRESS_SITEMAP_INDEX_URL=https://awesometechinc.com/sitemap_index.xml
WORDPRESS_PAGE_SITEMAP_URL=https://awesometechinc.com/page-sitemap.xml
WORDPRESS_POST_SITEMAP_URL=https://awesometechinc.com/post-sitemap.xml
WORDPRESS_WEBHOOK_SECRET=

# File Upload Settings
MAX_FILE_UPLOAD_MB=25
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,csv,txt,png,jpg,jpeg,webp

# Local Development
# Set to false after importing knowledge into Supabase.
USE_LOCAL_KNOWLEDGE=false
