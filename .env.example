# App
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Awesome Genie

# Supabase
# Create these from your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ADMIN_EMAIL=
SUPABASE_ADMIN_PASSWORD=

# AI Providers
# Fill only the providers you plan to use. Keep server-side keys out of client code.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Google Drive
# GOOGLE_PRIVATE_KEY usually contains escaped newlines: -----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# WordPress / Website Sync
WORDPRESS_BASE_URL=https://awesometechinc.com
WORDPRESS_SITEMAP_INDEX_URL=https://awesometechinc.com/sitemap_index.xml
WORDPRESS_PAGE_SITEMAP_URL=https://awesometechinc.com/page-sitemap.xml
WORDPRESS_POST_SITEMAP_URL=https://awesometechinc.com/post-sitemap.xml
WORDPRESS_WEBHOOK_SECRET=

# File Upload Settings
MAX_FILE_UPLOAD_MB=25
ALLOWED_FILE_TYPES=pdf,doc,docx,xls,xlsx,csv,txt,png,jpg,jpeg,webp

# Local Development
# Set to false after importing knowledge into Supabase.
USE_LOCAL_KNOWLEDGE=false
